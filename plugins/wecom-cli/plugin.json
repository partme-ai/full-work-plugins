{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "wecom-cli",
  "version": "0.1.1",
  "description": "Use the local WeCom CLI for messages, docs, sheets, mail, meetings, and tasks.",
  "author": {
    "name": "PartMe.AI"
  },
  "homepage": "https://github.com/full-work-plugins/wecom-cli-plugin",
  "repository": "https://github.com/full-work-plugins/wecom-cli-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "wecom",
    "wechat-work",
    "wecom-cli",
    "message",
    "docs",
    "sheets",
    "calendar",
    "todo"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "企业微信 CLI",
        "shortDescription": "企业微信 CLI 工作流：覆盖消息、文档、表格、邮件、日历、会议、通讯录和待办，并支持扫码授权。",
        "logo": "./assets/logo.png",
        "logoDark": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "composerIconDark": "./assets/logo.png"
      }
    }
  }
}
