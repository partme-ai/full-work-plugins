{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "lark-cli",
  "version": "0.1.2",
  "description": "Use the local Lark CLI for docs, sheets, Base, messages, and calendars.",
  "author": {
    "name": "PartMe.AI"
  },
  "homepage": "https://github.com/full-work-plugins/lark-cli-plugin",
  "repository": "https://github.com/full-work-plugins/lark-cli-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "feishu",
    "lark",
    "lark-cli",
    "docs",
    "sheets",
    "base",
    "calendar",
    "messaging"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "飞书 CLI",
        "shortDescription": "Lark CLI 工作流：覆盖文档、表格、多维表格、日历、消息等办公资源，并引导应用配置与 OAuth 登录。",
        "logo": "./assets/logo.png",
        "logoDark": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "composerIconDark": "./assets/logo.png"
      }
    }
  }
}
